{
  "name": "app",
  "version": "0.2.1",
  "private": true,
  "description": "Expo app for Android, iOS and the web build.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "build:android:dev": "pnpm dlx eas-cli build --platform android --profile development",
    "build:android:preview": "pnpm dlx eas-cli build --platform android --profile preview",
    "build:android": "pnpm dlx eas-cli build --platform android --profile production",
    "build:ios": "pnpm dlx eas-cli build --platform ios --profile production",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest.resolver.js",
    "globalSetup": "<rootDir>/jest.globalSetup.js",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@memory-journal/core": "workspace:*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "date-fns": "^4.4.0",
    "expo": "^58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "^58.0.16",
    "expo-dev-client": "^58.0.20",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "^58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "^58.0.31",
    "expo-status-bar": "^58.0.5",
    "firebase": "^12.19.0",
    "lucide-react-native": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "react-test-renderer": "^19.3.1",
    "typescript": "~6.0.3"
  }
}

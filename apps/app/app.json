{
  "expo": {
    "name": "Memory Journal",
    "slug": "memory-journal",
    "scheme": "memoryjournal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.memoryjournal.app"
    },
    "ios": {
      "bundleIdentifier": "com.memoryjournal.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "output": "static"
    },
    "plugins": ["expo-router", "@react-native-google-signin/google-signin", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0388f7bd-c63d-4e7d-ba36-74356cbc1d45"
      }
    },
    "owner": "chamabro"
  }
}

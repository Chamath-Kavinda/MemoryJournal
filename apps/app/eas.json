{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "ANDROID_ARCHS": "arm64-v8a,armeabi-v7a,x86,x86_64"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "ANDROID_ARCHS": "arm64-v8a,armeabi-v7a"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "ANDROID_ARCHS": "arm64-v8a,armeabi-v7a,x86,x86_64"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}

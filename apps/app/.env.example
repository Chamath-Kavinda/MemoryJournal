# Copy to .env and fill in. Never commit .env.
# Expo only exposes variables that start with EXPO_PUBLIC_, so none of these may be secrets.
# Values come from the Firebase console: Project settings > Your apps > Web app.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web client ID of the Google OAuth client (Google Cloud console > APIs & Services > Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Set to true to talk to the local emulators started with `pnpm emulators`.
# With emulators on, EXPO_PUBLIC_FIREBASE_PROJECT_ID should be demo-memory-journal.
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
